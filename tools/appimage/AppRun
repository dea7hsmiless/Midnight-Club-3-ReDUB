#!/bin/sh
set -eu
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
version=$(cat "$APPDIR/version" 2>/dev/null || printf 'unknown')
# Portable by default: everything lives beside the AppImage (or the AppDir when
# running from an extracted tarball), so deleting the folder takes the game,
# its saves and its settings with it. XDG is used only when an older install
# already has data there -- stranding somebody's career to satisfy a layout
# rule would be a worse bug than the one this fixes.
xdg_config=${XDG_CONFIG_HOME:-$HOME/.config}/redub
xdg_data=${XDG_DATA_HOME:-$HOME/.local/share}/redub
xdg_cache=${XDG_CACHE_HOME:-$HOME/.cache}/redub
xdg_state=${XDG_STATE_HOME:-$HOME/.local/state}/redub
package_dir=${APPIMAGE:+$(dirname -- "$APPIMAGE")}
package_dir=${package_dir:-$APPDIR}
portable_dir=${REDUB_HOME:-$package_dir/redub-data}
if [ ! -d "$portable_dir" ] && { [ -d "$xdg_data/saves" ] || [ -f "$xdg_config/mcdub3remix_env.txt" ]; }; then
    config_dir=$xdg_config
    data_dir=$xdg_data
    cache_dir=$xdg_cache
    state_dir=$xdg_state
    printf '%s\n' "note: keeping the existing data in $xdg_data; to go portable, move it to $portable_dir" >&2
else
    config_dir=$portable_dir/config
    data_dir=$portable_dir/data
    cache_dir=$portable_dir/cache
    state_dir=$portable_dir/state
fi
fail() {
    printf '%s\n' "$1" >&2
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -x "$APPDIR/usr/bin/redub-message" ]; then
        "$APPDIR/usr/bin/redub-message" "$1" || :
    fi
    exit 2
}
usage() {
    cat <<'HELP'
ReDUB for Linux (Remix)

Usage: ReDUB.AppImage [options]

Game files (required):
  --game-dir DIR        folder containing default.xbe (remembered beside the AppImage)
  MC3_GAME_DIR          same, as an environment variable

Where data goes (portable by default, beside the AppImage):
  --portable DIR        keep saves, settings, logs and caches inside DIR
  REDUB_HOME=DIR        the portable root (default: ./redub-data beside the AppImage)
  --save-dir DIR        saves only          (MC3_SAVE_DIR)
  --settings FILE       settings file       (MC3_SETTINGS_FILE)
  --hd DIR              HD texture pack     (RECOMP_GL_HD_DIR)
  Saves: ROOT/data/saves   Settings: ROOT/config/mcdub3remix_env.txt
  Logs:  ROOT/state        Caches:   ROOT/cache
  An existing XDG install keeps using its own folders; the start-up note says so.

Video and frame rate (same values as the launcher and Port Options):
  --fullscreen 0|1|2    0 windowed, 1 exclusive fullscreen, 2 borderless (restart)
  --resolution auto|WxH window size or display mode (restart)
  --scale N             internal resolution: 1, 1.5, 2, 3, 5 x native (restart)
  --frame-rate 30|60|120 30 is the default; 60 and 120 need a restart (120 needs
                        a 120 Hz display)
  --frame-gen off|crossfade|motion
                        frame generation (needs a 120 Hz display; default off)

Other:
  --diagnose            print versions, display and library state
  --version | --help
  --                    pass the remaining arguments to the game

Requires x86_64 Linux, glibc >= 2.39, OpenGL 3.3 and X11/XWayland.
FUSE-free: APPIMAGE_EXTRACT_AND_RUN=1 ./ReDUB.AppImage
HELP
}
read_location() {
    pointer=$1
    [ -r "$pointer" ] || return 0
    while IFS= read -r candidate || [ -n "$candidate" ]; do
        candidate=$(printf '%s' "$candidate" | sed 's/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//')
        case "$candidate" in ''|\#*) continue ;; esac
        case "$candidate" in \"*\") candidate=${candidate#\"}; candidate=${candidate%\"} ;; esac
        case "$candidate" in \'*\') candidate=${candidate#\'}; candidate=${candidate%\'} ;; esac
        case "$candidate" in /*) ;; *) candidate=$(dirname -- "$pointer")/$candidate ;; esac
        if [ -f "$candidate/default.xbe" ]; then MC3_GAME_DIR=$candidate; return 0; fi
    done < "$pointer"
}
apply_portable() {
    portable=$(CDPATH= cd -- "$1" 2>/dev/null && pwd) || fail "Portable folder does not exist: $1"
    config_dir=$portable/config
    data_dir=$portable/data
    cache_dir=$portable/cache
    state_dir=$portable/state
}
need_value() {
    [ "$#" -ge 2 ] || fail "$1 requires a value. Run with --help."
}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --version) printf 'ReDUB %s\n' "$version"; exit 0 ;;
        --diagnose)
            printf 'ReDUB %s\nAppDir: %s\n' "$version" "$APPDIR"
            getconf GNU_LIBC_VERSION
            printf 'Display: %s / %s\n' "${DISPLAY:-unset}" "${WAYLAND_DISPLAY:-unset}"
            ldd "$APPDIR/usr/bin/mcdub3remix"
            exit 0 ;;
        --game-dir)
            need_value "$@"
            [ -f "$2/default.xbe" ] || fail 'The chosen folder does not contain default.xbe.'
            MC3_GAME_DIR=$(CDPATH= cd -- "$2" && pwd)
            requested_game_dir=$MC3_GAME_DIR
            shift 2 ;;
        --portable)
            need_value "$@"
            mkdir -p "$2"
            apply_portable "$2"
            (umask 077; printf '%s\n' "$(CDPATH= cd -- "$2" && pwd)" > "$package_dir/redub.portable.tmp")
            mv -f -- "$package_dir/redub.portable.tmp" "$package_dir/redub.portable"
            shift 2 ;;
        --save-dir) need_value "$@"; MC3_SAVE_DIR=$2; shift 2 ;;
        --settings) need_value "$@"; MC3_SETTINGS_FILE=$2; shift 2 ;;
        --hd) need_value "$@"; RECOMP_GL_HD_DIR=$2; shift 2 ;;
        --fullscreen)
            need_value "$@"
            case "$2" in 0|1|2) MC3_FULLSCREEN=$2 ;; *) fail '--fullscreen takes 0, 1 or 2.' ;; esac
            shift 2 ;;
        --resolution)
            need_value "$@"
            case "$2" in auto|[0-9]*x[0-9]*) MC3_RESOLUTION=$2 ;; *) fail '--resolution takes auto or WIDTHxHEIGHT.' ;; esac
            shift 2 ;;
        --scale)
            need_value "$@"
            case "$2" in 1|1.5|2|3|5) RECOMP_GL_SCALE=$2 ;; *) fail '--scale takes 1, 1.5, 2, 3 or 5 (internal resolution, x native).' ;; esac
            shift 2 ;;
        --frame-rate)
            need_value "$@"
            case "$2" in
                30|60|120) MC3_FRAME_RATE=$2 ;;
                *) fail '--frame-rate takes 30, 60 or 120.' ;;
            esac
            shift 2 ;;
        --frame-gen)
            need_value "$@"
            case "$2" in
                off|0) RECOMP_FG=0 ;;
                crossfade|1) RECOMP_FG=1 ;;
                motion|2) RECOMP_FG=2 ;;
                *) fail '--frame-gen takes off, crossfade or motion.' ;;
            esac
            shift 2 ;;
        --) shift; break ;;
        -*) fail "Unknown option: $1. Run with --help." ;;
        *) break ;;
    esac
done
# Flag values only reach the game through the environment.
[ -z "${MC3_SAVE_DIR:-}" ] || export MC3_SAVE_DIR
[ -z "${MC3_SETTINGS_FILE:-}" ] || export MC3_SETTINGS_FILE
[ -z "${RECOMP_GL_HD_DIR:-}" ] || export RECOMP_GL_HD_DIR
[ -z "${MC3_FULLSCREEN:-}" ] || export MC3_FULLSCREEN
[ -z "${MC3_RESOLUTION:-}" ] || export MC3_RESOLUTION
[ -z "${RECOMP_GL_SCALE:-}" ] || export RECOMP_GL_SCALE
[ -z "${MC3_FRAME_RATE:-}" ] || export MC3_FRAME_RATE
# Portable mode can also come from the environment or a pointer beside the package.
if [ -n "${REDUB_DATA_DIR:-}" ]; then apply_portable "$REDUB_DATA_DIR"; fi
if [ -z "${REDUB_DATA_DIR:-}" ] && [ -r "$package_dir/redub.portable" ]; then
    read -r pointer < "$package_dir/redub.portable" || pointer=
    [ -n "${pointer:-}" ] && [ -d "$pointer" ] && apply_portable "$pointer"
fi
# Remember --game-dir only after portable mode chose the active config folder,
# so flags work in either order (and with REDUB_DATA_DIR).
if [ -n "${requested_game_dir:-}" ]; then
    mkdir -p "$config_dir"
    (umask 077; printf '%s\n' "$requested_game_dir" > "$config_dir/game-location.txt.tmp")
    mv -f -- "$config_dir/game-location.txt.tmp" "$config_dir/game-location.txt"
fi
if [ -z "${MC3_GAME_DIR:-}" ]; then read_location "$config_dir/game-location.txt"; fi
if [ -z "${MC3_GAME_DIR:-}" ]; then read_location "$package_dir/redub.game-location.txt"; fi
if [ -z "${MC3_GAME_DIR:-}" ] && [ -f "$package_dir/game-remix/default.xbe" ]; then MC3_GAME_DIR=$package_dir/game-remix; fi
[ -n "${MC3_GAME_DIR:-}" ] && [ -f "$MC3_GAME_DIR/default.xbe" ] || fail 'ReDUB needs your extracted Xbox Remix game files. Run this AppImage with --game-dir followed by the folder containing default.xbe, or put that folder path in redub.game-location.txt beside the AppImage. No game files are included.'
MC3_GAME_DIR=$(CDPATH= cd -- "$MC3_GAME_DIR" && pwd)
export MC3_GAME_DIR
# Native Wayland is not supported by this release; use X11 or XWayland.
case "${SDL_VIDEODRIVER:-x11}" in
    x11) export SDL_VIDEODRIVER=x11 ;;
    *) fail "This release supports X11/XWayland. Unset SDL_VIDEODRIVER or set it to x11." ;;
esac
export MC3_SAVE_DIR=${MC3_SAVE_DIR:-$data_dir/saves}
export MC3_SETTINGS_FILE=${MC3_SETTINGS_FILE:-$config_dir/mcdub3remix_env.txt}
if [ -z "${RECOMP_GL_HD_DIR:-}" ]; then
    if [ -d "$package_dir/hd" ]; then RECOMP_GL_HD_DIR=$package_dir/hd;
    elif [ -d "$data_dir/hd" ]; then RECOMP_GL_HD_DIR=$data_dir/hd;
    else RECOMP_GL_HD_DIR=$APPDIR/hd; fi
fi
export RECOMP_GL_HD_DIR
mkdir -p "$MC3_SAVE_DIR" "$(dirname -- "$MC3_SETTINGS_FILE")" "$cache_dir" "$state_dir"
[ ! -f "$state_dir/latest.log" ] || mv -f -- "$state_dir/latest.log" "$state_dir/previous.log"
cd "$cache_dir"
printf 'ReDUB %s\nStarted: %s\nGame: %s\n' "$version" "$(date -u +%FT%TZ)" "$MC3_GAME_DIR" > "$state_dir/latest.log"
set +e
"$APPDIR/usr/bin/mcdub3remix" "$@" >> "$state_dir/latest.log" 2>&1
status=$?
set -e
[ "$status" -eq 0 ] || fail "ReDUB exited with status $status. Details: $state_dir/latest.log"
exit "$status"
