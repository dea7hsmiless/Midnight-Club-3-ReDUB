# Game data: never commit anything from the disc.
/source/
/game/
# Other editions' and games' discs beside game/ (game-eur/, game-remix/,
# game-remix-eur/, ...): never committed.
/game-*/
*.iso
*.xbe
*.xiso
*_analysis.json

# Generated by tools/regen.sh (lifted C, ~100 MB) and the builds: one work
# folder per game (work-dub/, work-remix/); work/ before the split.
/work/
/work-*/
/gen/
/build*/
/switch_sd/
# The Android build (android/, ADR 0010): Gradle's caches and outputs, the
# NDK build's, and local.properties (this machine's SDK path).
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties

# Toolkit pipeline outputs, written inside the vendored tree.
/xboxrecomp/tools/*/output/

# Release artifacts: the zips and tarballs tools/release-check.sh inspects.
# Built locally, published from GitHub Releases, never committed (81 MB of
# packaged build tree is not a source file).
/release/

# Host clutter.
.DS_Store
__pycache__/
*.pyc
.vscode/
.idea/

# Personal folders
keys
bugs
drafts
assets/*
!assets/game-logo.jpeg
!assets/press/
!preview.png
!switch.png
TODO.md
# Your own Switch settings (the template is switch/mcdub3_env.example.txt).
/switch/mcdub3_env.txt
/switch/mcdub3remix_env.txt
# A player's settings file is never source (templates end in .example.txt).
*_env.txt
# Personal HD texture packs (beside game/; see hd_pack.c): never committed.
/hd/

# Generated Windows launcher binaries (build from .portable/Launcher.cs).
/ReDUB Launcher.exe
/.ReDUB Launcher.next.exe
/.redub-launcher-build/
/launcher-settings-test.exe
# Setup source shipped beside the launcher (generated by Bundle-Launcher-Source.ps1).
/launcher-source.zip
/launcher/launcher-source.zip

# Local launcher preferences and temporary policy test.
/launcher/preferences.ini
/launcher/preferences.ini.tmp
/launcher-bypass-test.exe
/.redub-source-manifest.txt
/.redub-source-manifest.txt.tmp
/*.redub-new
# Local Explorer copies and ad-hoc archives are never source inputs.
* - Copy*
tools.zip

# iOS build output: objects, the SDL static library and the multi-GB IPA
/ios/dist/
/work-remix/ios-build/
/work-remix/iossdl/

# Handoff and working notes are snapshots, not documentation (see AGENTS.md):
# keep them on this machine, never in the published repository.
*HANDOFF*.md
