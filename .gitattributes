# Windows scripts keep Windows line endings in every checkout.
*.bat text eol=crlf
*.sh text eol=lf

# AppImage entry point is a POSIX shell script without a suffix.
tools/appimage/AppRun text eol=lf

# SVG badges are vendored from the RecompLauncher press kit. Keep them exactly
# as shipped so a diff against the press kit stays meaningful.
*.svg text eol=lf

# The AppImage/package scripts and desktop metadata run inside Linux containers:
# CRLF breaks desktop-file-validate and shell shebangs. Keep this directory LF.
tools/appimage/** text eol=lf

# PNG signatures contain CRLF bytes; the directory's text rule must not
# normalize artwork when it is staged or checked out on Windows.
*.png -text

# Version files are sourced by bash on every platform. A CR from a Windows
# checkout is folded into the value by `source` and breaks version matching,
# so store and check them out as LF everywhere.
config/*/app.env text eol=lf
